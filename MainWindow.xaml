<Window x:Class="PdfSplitter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfSplitter"
        Title="PDF Splitter" Width="1500" Height="860" MinWidth="980" MinHeight="600"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontSize="13">
    <Window.Resources>
        <!-- A split "card": a drop target for dragged pages -->
        <Style x:Key="SplitCardItem" TargetType="ListBoxItem">
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <!-- Bubbling events: the card marks the drag handled before the window's file-drop handler can veto it -->
            <EventSetter Event="DragOver" Handler="SplitCard_DragOver"/>
            <EventSetter Event="DragLeave" Handler="SplitCard_DragLeave"/>
            <EventSetter Event="Drop" Handler="SplitCard_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="drop">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardNameBox" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraggingPages, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Viewer slot: no selection chrome, just the content -->
        <Style x:Key="ViewerItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP BAR ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ProjectBtn" Style="{StaticResource GhostButton}" Click="ProjectMenu_Click" ToolTip="Projects: new, open, save as, recent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ProjectNameText" Text="Untitled" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlineButton}" Click="OpenFiles_Click" Margin="10,0,0,0" ToolTip="Add PDFs or images (or just drop them anywhere)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="Add files"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Lit while Claude Desktop is connected through the extension -->
                <Border x:Name="McpPill" Visibility="Collapsed" CornerRadius="14" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Center"
                        Cursor="Hand" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        ToolTip="Claude Desktop is connected and can use PDF Splitter's tools. Click for details."
                        MouseLeftButtonUp="McpPill_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <TextBlock x:Name="McpPillText" Text="Claude Desktop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ChatToggleBtn" Style="{StaticResource OutlineButton}" Click="ToggleChat_Click" ToolTip="Show or hide the AI assistant (uses your API key)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="AI assistant"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="AiSettings_Click" ToolTip="API key, model, spend limit and usage" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/>
                </Button>
                <Button Style="{StaticResource OutlineButton}" Click="ExportSelected_Click" Content="Export selected" ToolTip="Write the selected split to a PDF"/>
                <Button Style="{StaticResource AccentButton}" Click="ExportAll_Click" Margin="0" ToolTip="Write every split to its own PDF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="Export all splits"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ MAIN PANES ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="ChatSplitCol" Width="0"/>
                <ColumnDefinition x:Name="ChatCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LIBRARY -->
            <Border x:Name="PagesCard" Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ViewPages_Click"
                                ToolTip="View pages full screen (or double-click a page)">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="14"/>
                        </Button>
                        <TextBlock x:Name="PoolInfoText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Title}" Text="Pages"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="SourcesList" Style="{StaticResource PlainListBox}" Margin="0,0,0,10"
                             ItemContainerStyle="{StaticResource ChipItem}" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="6,0,2,0" VerticalAlignment="Center"
                                               Text="{Binding PageCount, StringFormat={}{0} pg}"/>
                                    <Button Style="{StaticResource GhostButton}" Padding="5" Margin="2,0,0,0" Click="RemoveChip_Click"
                                            ToolTip="Remove this file (and its pages from any split)">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="PoolList" Style="{StaticResource PlainListBox}" SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource TileItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 SelectionChanged="PoolList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="Pool_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="Pool_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="Pool_PreviewMouseLeftButtonUp"
                                 MouseDoubleClick="Pool_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:VirtualizingGridPanel ItemWidth="128" ItemHeight="184"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="116" Margin="0,4" ToolTip="{Binding Caption}">
                                        <Border Width="104" Height="136" HorizontalAlignment="Center" CornerRadius="4" BorderThickness="1"
                                                ClipToBounds="True"
                                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Image Stretch="Uniform" Source="{Binding Thumb}" Loaded="Thumb_Loaded" Unloaded="Thumb_Unloaded"/>
                                        </Border>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="PoolEmpty" Style="{StaticResource EmptyHint}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="Drop PDFs or images here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource Caption}" Text="or use Add files. Pages appear here as a grid." HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <WrapPanel Margin="0,0,0,10">
                            <Button Style="{StaticResource AccentButton}" Click="NewSplitFromSelection_Click" Content="New split from selection"
                                    ToolTip="Ctrl/Shift-click to select pages, or drag them onto a split"/>
                            <Button Style="{StaticResource OutlineButton}" Click="AddSelectionToSplit_Click" Content="Add to selected split"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="RangeBox" VerticalContentAlignment="Center" Padding="8,6"
                                         ToolTip="Uses the file selected above.&#10;Commas combine pages into one split: 1-5, 8, 10-12&#10;Semicolons make several splits at once: 1-10; 11-20; 21-35"/>
                                <TextBlock Text="Page ranges, e.g. 1-10; 11-20; 21-35" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=RangeBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="NewSplitFromRange_Click" Content="Create splits"/>
                            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="AddRangeToSplit_Click" Content="Add to split"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- SPLITS -->
            <Border x:Name="SplitsCard" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="MoveSplitDown_Click" ToolTip="Move split down" Margin="0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="MoveSplitUp_Click" ToolTip="Move split up">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="NewEmptySplit_Click" ToolTip="Add an empty split">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="New"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SplitsCountText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource Title}" Text="Splits"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="SplitsList" Style="{StaticResource PlainListBox}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SplitCardItem}"
                                 AllowDrop="True" DragOver="SplitsArea_DragOver" Drop="SplitsArea_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,10,8,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBox Style="{StaticResource CardNameBox}" FontWeight="SemiBold" FontSize="14"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     GotKeyboardFocus="SplitName_GotKeyboardFocus"/>
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="5,3,0,0">
                                                <Run Text="{Binding CountText, Mode=OneWay}"/><Run Text=" &#183; "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Click="ViewSplit_Click" ToolTip="View this split full screen">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="13"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Margin="0" Click="DeleteSplitCard_Click"
                                                    ToolTip="Delete this split (pages stay in the file)">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="SplitsEmpty" Style="{StaticResource EmptyHint}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No splits yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Select pages and click New split,&#10;or drag pages here, or ask the AI assistant."/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="RemovePages_Click" ToolTip="Remove selected pages from this split" Margin="0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="PageDown_Click" ToolTip="Move selected pages down">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="PageUp_Click" ToolTip="Move selected pages up">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="13"/>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedItem.Name, ElementName=SplitsList, StringFormat=Pages in {0}, FallbackValue=Pages in the selected split}"/>
                    </DockPanel>

                    <ListBox Grid.Row="3" x:Name="SplitPagesList" Style="{StaticResource PlainListBox}" SelectionMode="Extended"
                             ItemsSource="{Binding SelectedItem.Pages, ElementName=SplitsList}" DisplayMemberPath="Caption"/>
                </Grid>
            </Border>

            <!-- AI ASSISTANT -->
            <GridSplitter x:Name="ChatSplitter" Grid.Column="3" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Visibility="Collapsed"/>
            <Border x:Name="ChatPanel" Grid.Column="4" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" x:Name="UndoBtn" Style="{StaticResource GhostButton}" Click="UndoAi_Click" IsEnabled="False"
                                ToolTip="Restore the splits to how they were before your last AI request" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Undo AI changes"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="NewChat_Click" ToolTip="New chat (start a fresh conversation)">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Title}" Text="AI assistant"/>
                            <!-- Always visible: this chat costs money, Claude Desktop does not -->
                            <Border CornerRadius="10" Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    ToolTip="This chat calls the Claude API with your API key and is billed per use. To use your Claude plan instead, chat in Claude Desktop with the PDF Splitter extension.">
                                <TextBlock FontSize="11" Text="API key &#183; billed per use" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Steers people to Claude Desktop (plan usage) instead of this API-billed chat -->
                        <Border x:Name="DesktopTip" Visibility="Collapsed" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderThickness="1"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DesktopTipText" TextWrapping="Wrap"/>
                                    <Button x:Name="DesktopTipAction" Style="{StaticResource OutlineButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Content="Set up Claude Desktop" Click="DesktopTipAction_Click"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="DesktopTipClose" Style="{StaticResource GhostButton}" Padding="6" Margin="8,-4,-6,0" VerticalAlignment="Top"
                                        Click="DesktopTipClose_Click" ToolTip="Don't show this tip again">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UsageText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ProgressBar x:Name="BudgetBar" Height="5" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="IndexText" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChatItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bd" Margin="0,4,36,4" Padding="12,9" CornerRadius="12" HorizontalAlignment="Left"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <TextBox x:Name="Tx" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="Bd" Property="Margin" Value="36,4,0,4"/>
                                            <Setter TargetName="Bd" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="tool">
                                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="Bd" Property="Padding" Value="12,1"/>
                                            <Setter TargetName="Bd" Property="Margin" Value="0,1,0,1"/>
                                            <Setter TargetName="Tx" Property="FontSize" Value="11"/>
                                            <Setter TargetName="Tx" Property="FontFamily" Value="Consolas"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="system">
                                            <Setter TargetName="Bd" Property="Margin" Value="0,4,0,4"/>
                                            <Setter TargetName="Bd" Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="error">
                                            <Setter TargetName="Bd" Property="Margin" Value="0,4,0,4"/>
                                            <Setter TargetName="Bd" Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="ChatInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="140" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="ChatInput_PreviewKeyDown"
                                     ToolTip="Enter to send, Shift+Enter for a new line. Billed to your API key."/>
                            <TextBlock IsHitTestVisible="False" Margin="12,11,12,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Message the assistant (billed to your API key)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ChatInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" x:Name="SendBtn" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Content="Send" Click="Send_Click"
                                VerticalAlignment="Stretch" MinWidth="70"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ BOTTOM BAR ============ -->
        <Grid Grid.Row="2" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Drop PDFs or images anywhere in this window."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="OutputBox" Width="360" VerticalContentAlignment="Center" Padding="8,4"
                         ToolTip="Output folder. Leave blank to save next to the first loaded file."/>
                <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseOutput_Click" ToolTip="Choose the output folder">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- FULL-SCREEN PAGE VIEWER (covers the whole window; Esc closes) -->
    <Grid x:Name="ViewerOverlay" Visibility="Collapsed" Focusable="True" Panel.ZIndex="100"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource OutlineButton}" Click="CloseViewer_Click" Margin="0" ToolTip="Back to the page grid (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <ComboBox Grid.Column="1" x:Name="ViewerSourceBox" Margin="14,0" MinWidth="280" MaxWidth="560" HorizontalAlignment="Left"
                          SelectionChanged="ViewerSource_SelectionChanged" ToolTip="What to view: a loaded file, or a split you are building"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Style="{StaticResource GhostButton}" Click="ViewerPrev_Click" ToolTip="Previous page (Left / PageUp)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="13"/>
                    </Button>
                    <TextBox x:Name="ViewerPageBox" Width="64" TextAlignment="Center" VerticalContentAlignment="Center"
                             KeyDown="ViewerPageBox_KeyDown" ToolTip="Type a page number and press Enter (G)"/>
                    <TextBlock x:Name="ViewerPageCount" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <Button Style="{StaticResource GhostButton}" Click="ViewerNext_Click" ToolTip="Next page (Right / PageDown)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="13"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Style="{StaticResource GhostButton}" Click="ViewerZoomOut_Click" ToolTip="Zoom out (-, Ctrl+wheel)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" FontSize="14"/>
                    </Button>
                    <TextBlock x:Name="ViewerZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center" Text="100%"/>
                    <Button Style="{StaticResource GhostButton}" Click="ViewerZoomIn_Click" ToolTip="Zoom in (+, Ctrl+wheel)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="ViewerFit_Click" Content="Fit" Margin="0" ToolTip="Fit one whole page to the window height"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="How many pages before and after the visible ones stay loaded. Lower uses less memory, higher scrolls more smoothly.">
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="Preload &#177;" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ViewerPreloadBox" Width="64" SelectionChanged="ViewerPreload_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- pages -->
        <Grid Grid.Row="1">
            <ListBox x:Name="ViewerList" Style="{StaticResource PlainListBox}" Focusable="False"
                     ItemContainerStyle="{StaticResource ViewerItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingGridPanel MaxColumns="1" ScrollStep="160"
                                                     ItemWidth="{Binding ViewerItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     ItemHeight="{Binding ViewerItemHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CacheRows="{Binding ViewerCacheRows, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Paper" BorderThickness="2" CornerRadius="4" BorderBrush="Transparent"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                                <Grid>
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="2"
                                           Loaded="ViewerImage_Loaded" Unloaded="ViewerImage_Unloaded"/>
                                    <Border x:Name="Tint" IsHitTestVisible="False" Opacity="0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="4"
                                            IsHitTestVisible="False" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding Marker}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Marker}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Paper" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InRange}" Value="True">
                                <Setter TargetName="Paper" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Tint" Property="Opacity" Value="0.10"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="ViewerEmpty" Style="{StaticResource EmptyHint}" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="Nothing to show" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Text="This split has no pages yet."/>
            </StackPanel>
        </Grid>

        <!-- range tools -->
        <Border Grid.Row="2" Padding="16,10" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="ViewerRangeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButton}" Click="ViewerMarkStart_Click" Content="Mark start (S)"/>
                    <Button Style="{StaticResource OutlineButton}" Click="ViewerMarkEnd_Click" Content="Mark end (E)"/>
                    <Button x:Name="ViewerClearBtn" Style="{StaticResource GhostButton}" Click="ViewerClearMarks_Click" Content="Clear" Margin="0,0,14,0"/>

                    <!-- viewing a file: turn the range into a split -->
                    <StackPanel x:Name="ViewerFileTools" Orientation="Horizontal">
                        <Button x:Name="ViewerNewSplitBtn" Style="{StaticResource AccentButton}" Click="ViewerNewSplit_Click" Content="New split from range"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="or add to" Margin="4,0,8,0"/>
                        <ComboBox x:Name="ViewerTargetBox" Width="200" DisplayMemberPath="Name" Margin="0,0,8,0"
                                  SelectionChanged="ViewerTarget_SelectionChanged"/>
                        <Button x:Name="ViewerAddBtn" Style="{StaticResource OutlineButton}" Click="ViewerAddToSplit_Click" Content="Add" Margin="0"/>
                    </StackPanel>

                    <!-- viewing a split: trim pages out of it -->
                    <StackPanel x:Name="ViewerSplitTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ViewerRemoveRangeBtn" Style="{StaticResource AccentButton}" Click="ViewerRemoveRange_Click" Content="Remove range from split"/>
                        <Button x:Name="ViewerRemovePageBtn" Style="{StaticResource OutlineButton}" Click="ViewerRemovePage_Click" Content="Remove this page" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Flying page copies and the expanding card for the open/close transitions (never takes input) -->
    <Canvas x:Name="TransitionLayer" Panel.ZIndex="200" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
</Window>
