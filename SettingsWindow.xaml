<Window x:Class="PdfSplitter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI settings" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- API key -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="Anthropic API key"/>
                <PasswordBox x:Name="KeyBox" Padding="8,6" Margin="0,10,0,0"/>
                <TextBlock x:Name="KeyStatus" Style="{StaticResource Caption}" Margin="2,6,0,8" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button Style="{StaticResource AccentButton}" Content="Save key" Click="SaveKey_Click"/>
                    <Button Style="{StaticResource OutlineButton}" Content="Test key" Click="TestKey_Click"/>
                    <Button Style="{StaticResource OutlineButton}" Content="Remove saved key" Click="RemoveKey_Click"/>
                </WrapPanel>
                <TextBlock x:Name="TestResult" Margin="2,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                           Text="Stored encrypted for your Windows account in %APPDATA%\PdfSplitter. If none is saved, the ANTHROPIC_API_KEY environment variable is used."/>
            </StackPanel>
        </Border>

        <!-- Model & limits -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="Model and limits"/>
                <TextBlock Style="{StaticResource Label}" Text="Model"/>
                <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch"/>
                <TextBlock Style="{StaticResource Label}" Text="Monthly spend limit (estimated, USD; 0 = no limit)"/>
                <TextBox x:Name="BudgetBox" Width="110" HorizontalAlignment="Left" Padding="8,6"/>
                <CheckBox x:Name="OcrBox" Margin="0,14,0,0" Content="OCR scanned pages in the background after loading a file"/>
            </StackPanel>
        </Border>

        <!-- Usage -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="Usage"/>
                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock x:Name="UsageText" FontFamily="Consolas" FontSize="12"/>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
                           Text="Costs are estimates from list prices for requests made by this app. Your real balance and billing are in the Anthropic Console."/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource OutlineButton}" Content="Open Anthropic Console usage" Click="OpenConsole_Click"/>
                    <Button Style="{StaticResource OutlineButton}" Content="Reset counters" Click="ResetUsage_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Button Style="{StaticResource AccentButton}" Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="Close_Click" IsDefault="True" MinWidth="90"/>
    </StackPanel>
</Window>
