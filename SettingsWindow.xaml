<Window x:Class="PdfSplitter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Label}" Text="Anthropic API key" Margin="0,0,0,4"/>
        <PasswordBox x:Name="KeyBox" Padding="4"/>
        <TextBlock x:Name="KeyStatus" Foreground="#555" Margin="0,4,0,6" TextWrapping="Wrap"/>
        <WrapPanel>
            <Button Content="Save key" Click="SaveKey_Click" FontWeight="SemiBold"/>
            <Button Content="Test key" Click="TestKey_Click"/>
            <Button Content="Remove saved key" Click="RemoveKey_Click"/>
        </WrapPanel>
        <TextBlock x:Name="TestResult" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="The key is stored encrypted for your Windows account in %APPDATA%\PdfSplitter. If none is saved, the ANTHROPIC_API_KEY environment variable is used."/>

        <TextBlock Style="{StaticResource Label}" Text="Model"/>
        <ComboBox x:Name="ModelBox"/>

        <TextBlock Style="{StaticResource Label}" Text="Monthly spend limit (estimated, USD; 0 = no limit)"/>
        <TextBox x:Name="BudgetBox" Width="100" HorizontalAlignment="Left"/>

        <CheckBox x:Name="OcrBox" Margin="0,12,0,0" Content="OCR scanned pages in the background after loading a file"/>

        <TextBlock Style="{StaticResource Label}" Text="Usage"/>
        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="8">
            <TextBlock x:Name="UsageText" FontFamily="Consolas" FontSize="12"/>
        </Border>
        <TextBlock Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Costs are estimates from list prices for requests made by this app. Your real balance and billing are in the Anthropic Console."/>
        <WrapPanel Margin="0,6,0,0">
            <Button Content="Open Anthropic Console usage" Click="OpenConsole_Click"/>
            <Button Content="Reset counters" Click="ResetUsage_Click"/>
        </WrapPanel>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" IsDefault="True" Width="80"/>
    </StackPanel>
</Window>
